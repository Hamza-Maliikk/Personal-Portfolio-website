---
// Option 1 (env file): .env mein PUBLIC_ keys daalein
// Option 2 (seedha): neeche "YOUR_..." ki jagah values paste karein
const PUBLIC_KEY =
  import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY ?? "YOUR_PUBLIC_KEY";
const SERVICE_ID =
  import.meta.env.PUBLIC_EMAILJS_SERVICE_ID ?? "YOUR_SERVICE_ID";
const NOTIFY_TEMPLATE_ID =
  import.meta.env.PUBLIC_EMAILJS_NOTIFY_TEMPLATE_ID ?? "template_6axleu7";
const AUTOREPLY_TEMPLATE_ID =
  import.meta.env.PUBLIC_EMAILJS_AUTOREPLY_TEMPLATE_ID ?? "template_r28jagw";
---

<section id="contact" class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">Let's talk</h2>
    <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-6">
      Contact
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="text-[var(--white-icon)]">
        <p class="mb-4">
          Have a question or a project in mind? Feel free to reach out.
        </p>
        <div class="flex items-center gap-2">
          <span>Location:</span>
          <span class="text-[var(--white)]">Karachi, Pakistan</span>
        </div>
      </div>

      <div>
        <form
          id="contact-form"
          class="flex flex-col gap-4"
          data-public-key={PUBLIC_KEY}
          data-service-id={SERVICE_ID}
          data-notify-template={NOTIFY_TEMPLATE_ID}
          data-autoreply-template={AUTOREPLY_TEMPLATE_ID}
        >
          <input
            type="text"
            name="from_name"
            placeholder="Name"
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <input
            type="email"
            name="reply_to"
            placeholder="Email"
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)]"
          />
          <textarea
            name="message"
            placeholder="Message"
            rows="6"
            required
            class="px-4 py-2 bg-[#1414149c] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] resize-none"
          ></textarea>
          <button
            id="submit-btn"
            type="submit"
            class="px-4 py-2 bg-[var(--white-icon-tr)] text-[var(--white)] rounded-lg opacity-60 transition-opacity border border-[var(--white-icon-tr)] hover:opacity-100 hover:bg-[var(--white-icon-tr)] disabled:cursor-not-allowed"
          >
            Submit
          </button>
        </form>
        <div
          id="form-message"
          class="hidden justify-center items-center mt-4 text-[var(--white)] text-lg"
        >
          ✅ Thank you for your message!
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4.4.1/dist/email.min.js"></script>
<script is:inline>
  const form = document.getElementById("contact-form");
  const formMessage = document.getElementById("form-message");
  const submitBtn = document.getElementById("submit-btn");

  const PUBLIC_KEY = form.dataset.publicKey;
  const SERVICE_ID = form.dataset.serviceId;
  const NOTIFY_TEMPLATE_ID = form.dataset.notifyTemplate;
  const AUTOREPLY_TEMPLATE_ID = form.dataset.autoreplyTemplate;

  emailjs.init({ publicKey: PUBLIC_KEY });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = "Sending...";

    try {
      // 1. Message aapke inbox mein
      await emailjs.sendForm(SERVICE_ID, NOTIFY_TEMPLATE_ID, form);

      // 2. Visitor ko auto-reply (fail ho to form fail nahi hoga)
      try {
        await emailjs.sendForm(SERVICE_ID, AUTOREPLY_TEMPLATE_ID, form);
      } catch (err) {
        console.error("Auto-reply failed:", err);
      }

      form.reset();
      form.style.display = "none";
      formMessage.classList.remove("hidden");
      formMessage.classList.add("flex");
    } catch (error) {
      console.error("Error:", error);
      alert("There was a problem sending your message.");
      submitBtn.disabled = false;
      submitBtn.textContent = "Submit";
    }
  });
</script>